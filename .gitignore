/target
node_modules/
dist/
.venv/
__pycache__/
*.pyc
# large corpora live outside the repo or in tests/corpus/cache (never committed)
tests/corpus/cache/
tests/out/
.claude/
fuzz/target/
fuzz/corpus/
fuzz/artifacts/
fuzz/Cargo.lock
# patched third-party sources, generated by tools/vendor/fetch_acadrust.py. Only the
# manifest is committed, so tools that can't run the script (Dependabot) still resolve
# the workspace's [patch.crates-io].
/vendor/*
!/vendor/acadrust/
/vendor/acadrust/*
!/vendor/acadrust/Cargo.toml
web/test-results/
web/playwright-report/
